@model IEnumerable<Book>

@{
    ViewData["Title"] = "Список книг";
    var searchString = Context.Request.Query["searchString"];
}

<link href="~/css/index-book.css" rel="stylesheet" />

<h1>@ViewData["Title"]</h1>

<!-- Форма поиска -->
<form asp-action="Index" method="get" class="search-form">
    <div class="search-group">
        <input type="text"
               name="searchString"
               id="searchString"
               class="search-input"
               placeholder="Поиск по названию книги или ФИО автора..."
               value="@searchString" />
        <button type="submit" class="btn-search">Найти</button>
        @if (!string.IsNullOrEmpty(searchString))
        {
            <a asp-action="Index" class="btn-clear">Очистить</a>
        }
    </div>
</form>

<button type="button" class="btn-add-book" onclick="window.location.href='@Url.Action("Create")'">
    + Добавить книгу
</button>

@if (!Model.Any())
{
    <p>Книг пока нет.</p>
}
else
{
    <table class="book-list-table">
        <thead>
            <tr>
                <th>Название</th>
                <th>Авторы</th>
                <th>Год издания</th>
                <th style="width: 120px;">Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in Model)
            {
                <tr class="book-row">
                    <td class="book-title">
                        <a href="@Url.Action("Details", new { id = book.Id })" class="book-link">
                            @book.Name
                        </a>
                    </td>

                    <td class="book-authors">
                        @if (book.Authors != null && book.Authors.Any())
                        {
                            @foreach (var author in book.Authors)
                            {
                                <span class="author-name">
                                    @author.MiddleName @author.FirstName @(string.IsNullOrEmpty(author.LastName) ? "" : $" {author.LastName}")
                                </span>
                                @if (author != book.Authors.Last())
                                {
                                    <text>, </text>
                                }
                            }
                        }
                        else
                        {
                            <span class="text-muted">Нет авторов</span>
                        }
                    </td>

                    <td class="book-year">@book.YearPublished</td>

                    <td>
                        <form asp-action="Delete" asp-route-id="@book.Id" method="post"
                              onsubmit="return confirm('Вы уверены, что хотите удалить эту книгу?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-delete" title="Удалить книгу">Удалить</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
