@model EditBookViewModel

@{
    ViewData["Title"] = Model.Name;
}

<link rel="stylesheet" href="~/css/edit-book.css" asp-append-version="true" />

<div class="book-details-container">
    <h1>Редактирование книги</h1>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" id="editForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="form-group">
            <label asp-for="Name">Название</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="YearPublished">Год издания</label>
            <input asp-for="YearPublished" class="form-control" type="number" />
            <span asp-validation-for="YearPublished" class="text-danger"></span>
        </div>

        <hr />

        <h3>Авторы</h3>

        <div class="author-add-form">
            <input type="text" id="newMiddleName" placeholder="Фамилия" class="author-input" />
            <input type="text" id="newFirstName" placeholder="Имя" class="author-input" />
            <input type="text" id="newLastName" placeholder="Отчество" class="author-input" />
            <button type="button" id="btnAddAuthor" class="btn-add-author-small">+ Добавить</button>
        </div>

        <ul id="authorsList" class="authors-list">
            @for (int i = 0; i < Model.Authors.Count; i++)
            {
                var author = Model.Authors[i];
                <li class="author-item">
                    <span class="author-display">
                        @author.MiddleName @author.FirstName @(string.IsNullOrEmpty(author.LastName) ? "" : author.LastName)
                    </span>
                    <button type="button" class="btn-remove-author" data-index="@i">×</button>

                    <input type="hidden" name="Authors[@i].MiddleName" value="@author.MiddleName" />
                    <input type="hidden" name="Authors[@i].FirstName" value="@author.FirstName" />
                    <input type="hidden" name="Authors[@i].LastName" value="@(author.LastName ?? "")" />
                </li>
            }
        </ul>

        <hr />

        <h3>Оглавление (редактор)</h3>
        <div class="form-group">
            <label>Оглавление</label>
            <textarea asp-for="TableOfContentsHtml" id="TableOfContentsHtml" class="xml-textarea" spellcheck="false"></textarea>
            <small style="color:#666;">При сохранении содержимое конвертируется в XML.</small>
        </div>

        <div class="actions">
            <button type="submit" class="btn-save">Сохранить</button>
            <a href="@Url.Action("Index")" class="btn-back">Отмена</a>
        </div>
    </form>
</div>

<!-- Подключаем логику авторов -->
<script src="~/js/book-authors.js" asp-append-version="true"></script>

<!-- TinyMCE -->
<script src="https://cdn.tiny.cloud/1/no-api-key/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>

<script>
    if (typeof tinymce !== 'undefined') {
        tinymce.init({
            selector: '#TableOfContentsHtml',
            height: 400,
            plugins: 'lists link image table code',
            toolbar: 'undo redo | bold italic underline | bullist numlist | link | code',
            menubar: false
        });
    }
</script>

<script>
    document.getElementById('editForm').addEventListener('submit', function () {
        if (typeof tinymce !== 'undefined') {
            tinymce.triggerSave();
        }
    });
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
